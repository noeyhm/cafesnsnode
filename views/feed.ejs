<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f8f7f3">
  <title>동네픽 - 우리 동네 신메뉴 피드</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/feed.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/" aria-label="동네픽 홈">
      <span class="brand-mark">d</span>
      <span>dongne<span class="brand-accent">pick</span></span>
    </a>
    <form class="search" action="/" method="get" role="search">
      <span aria-hidden="true">⌕</span>
      <input type="search" name="tag" value="<%= tag %>" placeholder="동네, 가게, 해시태그 검색" aria-label="동네, 가게, 해시태그 검색">
      <% if (tag) { %><a class="clear-search" href="/" aria-label="검색 초기화">×</a><% } %>
    </form>
    <nav class="top-actions" aria-label="계정 메뉴">
      <% if (username) { %>
        <span class="nav-greeting"><%= username %>님, 반가워요</span>
        <button class="button button-dark" type="button" data-open-post>＋ 새 게시물</button>
        <a class="icon-link" href="/logout">로그아웃</a>
      <% } else { %>
        <a class="login-link" href="/login">로그인</a>
        <a class="button button-dark" href="/register">동네픽 시작하기 <span>↗</span></a>
      <% } %>
    </nav>
  </header>

  <main class="layout">
    <aside class="left-rail">
      <div class="location-card">
        <span class="eyebrow">오늘의 동네</span>
        <div class="location-title"><span class="location-pin">⌖</span>서울 · 강남구</div>
        <a href="#feed" class="location-change">지역 태그로 둘러보기 <span>→</span></a>
      </div>
      <nav class="side-nav" aria-label="피드 메뉴">
        <a class="side-link active" href="/"><span>⌂</span> 오늘의 피드</a>
        <a class="side-link" href="/?tag=%23%EC%98%A4%ED%94%88%EC%9D%B4%EB%B2%A4%ED%8A%B8"><span>✳</span> 오픈 이벤트</a>
        <a class="side-link" href="/?tag=%23%EC%8B%A0%EB%A9%94%EB%89%B4"><span>◉</span> 신메뉴 모아보기</a>
      </nav>
      <div class="rail-note">
        <span class="note-icon">✦</span>
        <strong>우리 동네 발견</strong>
        <p>사장님의 새 소식부터 이웃의 솔직한 인증샷까지.</p>
      </div>
      <p class="rail-foot">동네픽 · 오늘도 가까운 곳에서<br>좋은 맛을 발견해요.</p>
    </aside>

    <section class="feed-column" id="feed">
      <section class="welcome">
        <div class="welcome-copy">
          <span class="eyebrow">NEIGHBORHOOD FINDS</span>
          <h1>오늘, 동네에서<br><span>새로운 맛을 발견해요.</span></h1>
          <p>가까운 카페와 맛집의 신메뉴, 지금만 하는 이벤트를 한눈에.</p>
        </div>
        <div class="welcome-doodle" aria-hidden="true">
          <span class="doodle-spark">✳</span><span class="doodle-cup">☕</span><span class="doodle-dot"></span>
        </div>
      </section>

      <section class="tag-section" aria-label="인기 태그">
        <div class="section-heading">
          <div><span class="eyebrow">NEAR YOU</span><h2>요즘 뜨는 동네 태그</h2></div>
          <span class="heading-note">가볍게 눌러 둘러보세요</span>
        </div>
        <div class="tag-list">
          <% [
            {label:"#부평카페", value:"#부평카페", tone:"mint"},
            {label:"#오픈이벤트", value:"#오픈이벤트", tone:"peach"},
            {label:"#신메뉴", value:"#신메뉴", tone:"lavender"},
            {label:"#강남맛집", value:"#강남맛집", tone:"yellow"},
            {label:"#아메리카노할인", value:"#아메리카노할인", tone:"blue"}
          ].forEach((item) => { %>
            <a class="tag-chip <%= item.tone %>" href="/?tag=<%= encodeURIComponent(item.value) %>"><%= item.label %><span>↗</span></a>
          <% }); %>
        </div>
      </section>

      <div class="feed-heading">
        <div><span class="eyebrow">FRESH FROM YOUR NEIGHBORHOOD</span><h2><%= tag ? `“${tag}” 주변 소식` : "오늘의 동네 소식" %></h2></div>
        <span class="post-count"><%= posts.length %>개의 이야기</span>
      </div>

      <div class="post-list">
        <% posts.forEach((post, index) => { %>
          <article class="post-card">
            <div class="post-top">
              <div class="avatar <%= ['avatar-peach', 'avatar-green', 'avatar-blue'][index % 3] %>"><%= post.storeName.slice(0, 1) %></div>
              <div class="post-author">
                <strong><%= post.storeName %></strong>
                <span><%= post.tags.split(" ")[0] || "#우리동네" %> · <%= post.author ? `@${post.author}` : "동네 가게" %></span>
              </div>
              <button class="more-button" type="button" aria-label="게시물 메뉴">···</button>
            </div>
            <div class="post-photo-wrap">
              <img class="post-photo" src="<%= post.imageUrl %>" alt="<%= post.storeName %>의 신메뉴 사진" loading="<%= index > 0 ? 'lazy' : 'eager' %>">
              <span class="photo-label">LOCAL PICK <span>✦</span></span>
            </div>
            <div class="post-content">
              <div class="post-actions">
                <% if (username) { %>
                  <form action="/posts/<%= post.id %>/like" method="post">
                    <button class="like-button <%= post.liked ? 'is-liked' : '' %>" type="submit" aria-label="좋아요"><%= post.liked ? "♥" : "♡" %></button>
                  </form>
                <% } else { %>
                  <a class="like-button" href="/login" aria-label="로그인하고 좋아요">♡</a>
                <% } %>
                <span class="like-count">좋아요 <strong><%= post.likeCount %></strong></span>
                <span class="comment-count">댓글 <strong><%= post.commentCount %></strong></span>
                <span class="post-time"><%= post.createdAt %></span>
              </div>
              <p class="caption"><strong><%= post.storeName %></strong> <%= post.caption %></p>
              <div class="post-tags"><% post.tags.split(/\s+/).forEach((postTag) => { %><a href="/?tag=<%= encodeURIComponent(postTag) %>"><%= postTag %></a><% }); %></div>
              <% if (post.comments.length) { %>
                <div class="comments">
                  <% post.comments.forEach((comment) => { %><p><strong><%= comment.author %></strong> <%= comment.content %></p><% }); %>
                </div>
              <% } %>
              <% if (username) { %>
                <form class="comment-form" action="/posts/<%= post.id %>/comments" method="post">
                  <label class="sr-only" for="comment-<%= post.id %>">댓글 작성</label>
                  <input id="comment-<%= post.id %>" name="content" maxlength="300" placeholder="이웃에게 한마디 남겨보세요" required>
                  <button type="submit">게시</button>
                </form>
              <% } else { %>
                <a class="comment-login" href="/login">로그인하고 댓글과 좋아요로 이웃과 소통해보세요 <span>→</span></a>
              <% } %>
            </div>
          </article>
        <% }); %>
        <% if (!posts.length) { %>
          <div class="empty-state"><span>⌕</span><h3>아직 이 태그의 소식이 없어요</h3><p>다른 태그로 검색하거나 첫 번째 동네 소식을 올려보세요.</p><a href="/">전체 피드 보기</a></div>
        <% } %>
      </div>
      <footer class="mobile-footer">가까운 곳의 좋은 발견, <strong>동네픽</strong></footer>
    </section>

    <aside class="right-rail">
      <section class="today-card">
        <div class="today-header"><span class="today-icon">✦</span><span class="eyebrow">LOCAL SPOTLIGHT</span></div>
        <h3>오늘의 한 입</h3>
        <p>동네 사장님이 직접 전하는<br>오늘만의 작은 혜택.</p>
        <a href="/?tag=%23오픈이벤트">이벤트 둘러보기 <span>↗</span></a>
        <div class="today-decoration" aria-hidden="true">✳</div>
      </section>
      <section class="howto-card">
        <span class="eyebrow">HOW IT WORKS</span>
        <h3>동네픽 사용법</h3>
        <ol>
          <li><span>01</span>동네 태그로 가게 찾기</li>
          <li><span>02</span>신메뉴와 혜택 확인하기</li>
          <li><span>03</span>방문 인증샷과 태그 공유하기</li>
        </ol>
      </section>
      <p class="right-foot">작은 가게와 동네 이웃을<br>가깝게 잇는 로컬 피드.</p>
    </aside>
  </main>

  <% if (username) { %>
    <dialog class="post-dialog" data-post-dialog>
      <form class="dialog-form" action="/posts" method="post">
        <div class="dialog-head"><div><span class="eyebrow">SHARE YOUR LOCAL STORY</span><h2>동네 소식 올리기</h2></div><button type="button" class="dialog-close" data-close-post aria-label="닫기">×</button></div>
        <label>가게 이름<input name="storeName" maxlength="80" placeholder="예: 오후의 온도" required></label>
        <label>사진 주소<input name="imageUrl" type="url" placeholder="https://..." required data-image-url></label>
        <img class="image-preview" data-image-preview alt="사진 미리보기" hidden>
        <label>오늘의 소식<textarea name="caption" rows="3" maxlength="500" placeholder="신메뉴나 이벤트를 소개해 주세요." required></textarea></label>
        <label>지역·이벤트 태그<input name="tags" maxlength="200" placeholder="#부평카페 #오픈이벤트" required></label>
        <p class="dialog-hint">사진은 공개된 http(s) 이미지 주소를 입력해 주세요.</p>
        <button class="button button-dark submit-post" type="submit">피드에 공유하기 <span>↗</span></button>
      </form>
    </dialog>
  <% } %>
  <script src="/js/feed.js" defer></script>
</body>
</html>
